{
  "name": "astro-og-seo-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run astro-og-seo#test:all && vp run -r build",
    "dev": "vp run -r --parallel dev",
    "prepare": "vp config",
    "test": "vp run astro-og-seo#test:all"
  },
  "devDependencies": {
    "decode-named-character-reference": "^1.3.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "vite-plus": "latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.13"
}
