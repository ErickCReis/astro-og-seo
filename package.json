{
  "name": "astro-og-seo-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp run astro-og-seo#build && vp check && vp run astro-og-seo#test:all && vp run package:smoke && vp run -r build",
    "package:smoke": "vp run astro-og-seo#test:package",
    "dev": "vp run astro-og-seo#build && vp run -r --parallel dev",
    "prepare": "vp config",
    "test": "vp run astro-og-seo#test:all"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^4.1.10",
    "decode-named-character-reference": "^1.3.0",
    "happy-dom": "^20.11.1",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.3",
    "vite-plus": "0.2.6"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "svgo": "4.0.2",
    "undici": "7.28.0",
    "ws": "8.21.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.13"
}
