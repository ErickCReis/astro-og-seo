---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Astro OG SEO with Tailwind CSS"
  description="This page uses Tailwind CSS utilities in its generated Open Graph image."
  imageStyle="tailwind"
>
  <main class="mx-auto max-w-3xl px-6 py-16 font-sans">
    <p class="mb-4 text-sm font-semibold uppercase tracking-wide text-cyan-700">Tailwind CSS</p>
    <h1 class="text-4xl font-bold tracking-tight text-gray-900">Generated with utilities</h1>
    <p class="mt-4 text-lg text-gray-600">
      Compare this route with the plain CSS example at <a class="text-cyan-700 underline" href="/">/</a>.
    </p>
  </main>
</Layout>
