{
  "name": "astro-og-seo",
  "version": "0.1.2",
  "description": "SEO metadata, Open Graph images, and a dev-toolbar inspector for Astro",
  "keywords": [
    "astro-component",
    "astro-integration",
    "dev-toolbar",
    "image",
    "open-graph",
    "seo"
  ],
  "homepage": "https://github.com/ErickCReis/astro-og-seo#readme",
  "bugs": {
    "url": "https://github.com/ErickCReis/astro-og-seo/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErickCReis/astro-og-seo.git",
    "directory": "packages/astro-og-seo"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./OgSeo.astro": "./dist/components/OgSeo.astro"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch --no-clean",
    "test": "vp test run",
    "test:unit": "vp test run --project unit",
    "test:integration": "vp pack && vp test run --project integration",
    "test:browser": "vp test run --project browser",
    "test:package": "vp pack && npm pack --dry-run --json",
    "test:update": "vp test run --update",
    "test:all": "vp run test:unit && vp run test:integration && vp run test:browser && vp run test:e2e",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@takumi-rs/core": "^2.4.2",
    "solid-js": "^1.9.14",
    "takumi-js": "^2.4.2"
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.14",
    "@types/node": "^26.1.1",
    "astro": "7.1.3",
    "bumpp": "^12.0.0",
    "typescript": "^7.0.2",
    "vite-plugin-solid": "^2.11.13",
    "vite-plus": "^0.2.6"
  },
  "peerDependencies": {
    "astro": "^6.4.6 || ^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
